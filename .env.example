# AIResearcher Windows 本地开发配置模板。
# 1. 在仓库根目录执行：Copy-Item .\.env.example .\.env
# 2. 替换 API Key、两个 MySQL 密码，并确认原件库与模型缓存路径。
# 3. 运行：.\scripts\start-dev.ps1 -CheckOnly
# 4. 检查通过后运行：.\scripts\start-dev.ps1
# .env 已被 Git 忽略；不要提交或打印任何真实秘密。

# 必填：DeepSeek 模型服务。
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 必填：两个不同的随机密码。Compose 仅在首次初始化空 MySQL volume 时使用它们。
AIRESEARCHER_DB_HOST=127.0.0.1
AIRESEARCHER_DB_PORT=3306
AIRESEARCHER_DB_NAME=airesearcher_agent
AIRESEARCHER_DB_USER=airesearcher
AIRESEARCHER_DB_PASSWORD=replace-with-application-database-password
AIRESEARCHER_DB_ROOT_PASSWORD=replace-with-separate-root-password

# 可保持默认：Qdrant 地址与 collection。
AIRESEARCHER_QDRANT_URL=http://127.0.0.1:6333
AIRESEARCHER_QDRANT_COLLECTION=airesearcher_chunks_v1

# 必填：本地论文原件库必须位于仓库的 .private 子目录中，并由 Git 忽略。
# 正常启动会创建 originals/ 与 .staging/；-CheckOnly 不创建目录。
AIRESEARCHER_PAPER_LIBRARY_DIR=.private/paper-library

# 仅旧数据迁移期间可选：旧版 PDF storage。新安装无需设置。
# AIRESEARCHER_STORAGE_DIR=C:/Users/your-name/.airesearcher/storage

# 必填：模型缓存必须位于仓库外。
AIRESEARCHER_MODEL_CACHE_DIR=C:/Users/your-name/.cache/airesearcher/models

# 可保持默认：本地 embedding/reranker 模型与运行参数。
AIRESEARCHER_EMBEDDING_MODEL=BAAI/bge-m3
AIRESEARCHER_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
AIRESEARCHER_MODEL_DEVICE=auto
AIRESEARCHER_VECTOR_SIZE=1024

# 可保持默认：三个应用的本地连接地址与超时。
AIRESEARCHER_AGENT_BASE_URL=http://127.0.0.1:8000
AIRESEARCHER_AGENT_CONNECT_TIMEOUT=2s
AIRESEARCHER_AGENT_OPEN_TIMEOUT=5s
AIRESEARCHER_SSE_EMITTER_TIMEOUT=0ms
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
