{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airesearcher.dev/contracts/sse/v1/stream-open-error.schema.json",
  "title": "AIResearcher StreamOpenError v1",
  "description": "SSE 建流前非 2xx JSON 错误体；不使用 Result<T> 包装。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "code",
    "message",
    "requestId",
    "retryable"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  }
}
