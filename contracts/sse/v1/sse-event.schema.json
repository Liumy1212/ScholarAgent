{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airesearcher.dev/contracts/sse/v1/sse-event.schema.json",
  "title": "AIResearcher SSE event v1",
  "description": "Phase 0 流式问答数据事件的 JSON envelope。",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/runStartedEvent"
    },
    {
      "$ref": "#/$defs/messageDeltaEvent"
    },
    {
      "$ref": "#/$defs/citationCreatedEvent"
    },
    {
      "$ref": "#/$defs/runCompletedEvent"
    },
    {
      "$ref": "#/$defs/runFailedEvent"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "baseEvent": {
      "type": "object",
      "required": [
        "schemaVersion",
        "eventId",
        "requestId",
        "runId",
        "conversationId",
        "assistantMessageId",
        "sequence",
        "timestamp"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "eventId": {
          "$ref": "#/$defs/identifier"
        },
        "requestId": {
          "$ref": "#/$defs/identifier"
        },
        "runId": {
          "$ref": "#/$defs/identifier"
        },
        "conversationId": {
          "$ref": "#/$defs/identifier"
        },
        "assistantMessageId": {
          "$ref": "#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "runStartedPayload": {
      "type": "object",
      "additionalProperties": false
    },
    "messageDeltaPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delta"
      ],
      "properties": {
        "delta": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "citationCreatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citationId",
        "paperId",
        "paperTitle",
        "pageNumber",
        "quote"
      ],
      "properties": {
        "citationId": {
          "$ref": "#/$defs/identifier"
        },
        "paperId": {
          "$ref": "#/$defs/identifier"
        },
        "paperTitle": {
          "type": "string",
          "minLength": 1
        },
        "pageNumber": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runCompletedPayload": {
      "type": "object",
      "additionalProperties": false
    },
    "runFailedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "runStartedEvent": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "required": [
            "type",
            "payload"
          ],
          "properties": {
            "type": {
              "const": "run.started"
            },
            "payload": {
              "$ref": "#/$defs/runStartedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "messageDeltaEvent": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "required": [
            "type",
            "payload"
          ],
          "properties": {
            "type": {
              "const": "message.delta"
            },
            "payload": {
              "$ref": "#/$defs/messageDeltaPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "citationCreatedEvent": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "required": [
            "type",
            "payload"
          ],
          "properties": {
            "type": {
              "const": "citation.created"
            },
            "payload": {
              "$ref": "#/$defs/citationCreatedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "runCompletedEvent": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "required": [
            "type",
            "payload"
          ],
          "properties": {
            "type": {
              "const": "run.completed"
            },
            "payload": {
              "$ref": "#/$defs/runCompletedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "runFailedEvent": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "required": [
            "type",
            "payload"
          ],
          "properties": {
            "type": {
              "const": "run.failed"
            },
            "payload": {
              "$ref": "#/$defs/runFailedPayload"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
